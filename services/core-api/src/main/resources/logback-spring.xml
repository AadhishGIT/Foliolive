<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STRUCTURED_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","thread":"%thread","logger":"%logger{36}","correlationId":"%X{correlationId:-none}","message":"%replace(%msg){'[\r\n\t]+',' '}"}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STRUCTURED_CONSOLE" />
    </root>
</configuration>
