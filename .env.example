# Database (PostgreSQL 16)
POSTGRES_DB=foliolive
POSTGRES_USER=foliolive_user
POSTGRES_PASSWORD=foliolive_dev_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Core API (Spring Boot 3)
CORE_API_PORT=8080
CORE_API_URL=http://localhost:8080
JWT_SECRET=foliolive-development-hmac-sha256-secret-must-be-at-least-32-bytes!
JWT_EXPIRATION_SECONDS=86400

# BFF / Realtime Gateway (Node.js + Express + WS)
BFF_PORT=4000
BFF_URL=http://localhost:4000
BFF_WS_URL=ws://localhost:4000/ws
NODE_ENV=development

# Micro-frontend URLs
SHELL_PORT=3000
VITE_SHELL_URL=http://localhost:3000
PORTFOLIO_MFE_PORT=3001
VITE_PORTFOLIO_MFE_URL=http://localhost:3001
RISK_MFE_PORT=3002
VITE_RISK_MFE_URL=http://localhost:3002
ALERTS_MFE_PORT=3003
VITE_ALERTS_MFE_URL=http://localhost:3003

# Market Simulation
SIMULATION_SEED=42
SIMULATION_TICK_INTERVAL_MS=500

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
